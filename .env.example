# =============================================================================
# 大肥鱼 QQ 机器人配置模板
# 复制为 .env 后填入自己的凭据：cp .env.example .env
# .env 已被 .gitignore 排除，切勿提交真实 APP_SECRET。
# =============================================================================

# QQ 开放平台 -> 机器人 -> 开发设置
APP_ID=
APP_SECRET=

# AI（OpenAI 兼容接口，可接 DeepSeek / 阿里云 MaaS / 其他兼容服务）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
# 正常聊天、插话使用的模型
AI_MODEL=deepseek-chat
# 群聊重要性判断使用的模型，留空则复用 AI_MODEL
AI_JUDGE_MODEL=
# 是否让模型输出推理过程（true/false）；留空表示不下发该参数
# 阿里云 MaaS / DashScope 支持 enable_thinking=false，可显著提速并省 token
AI_ENABLE_THINKING=false
AI_ENABLED=true
AI_TIMEOUT=60
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.8
# 可选：覆盖默认人设（留空使用 config.py 里的 DEFAULT_AI_SYSTEM_PROMPT，
# 默认是蓝色鲸鱼尾巴的小萝莉，主人是 tony1026）
# AI_SYSTEM_PROMPT=
# false = 关闭“你好/在吗/摸鱼”等固定关键词回复，交给 AI
FIXED_REPLIES_ENABLED=false
# 群聊先让 AI 判断消息重要性，只有值得回复时才说话
GROUP_REPLY_JUDGE=true
# 判断时携带的最近上下文长度（字），越小越省钱
GROUP_JUDGE_CONTEXT_CHARS=2000
# 同一群两次 AI 主动回复的最小间隔（秒），0=关闭
GROUP_REPLY_COOLDOWN=3
# 连续多少条群消息没回复后，主动插一句话；0=关闭
GROUP_IDLE_SPEAK_EVERY=15

# 表情包库：自动收藏群图片、AI 识别内容、按话题主动发送
MEME_AUTO_COLLECT=true
MEME_ANALYZE=true
MEME_SEND_ENABLED=true
MEME_SEND_COOLDOWN=30
MEME_MAX_FILES=200
MEME_CATALOG_LIMIT=12

# 网页读取：只在你 @机器人、私聊或引用机器人时抓取链接正文
# 每次回复最多附加的网页正文字数；设成 0 等于关闭
WEB_FETCH_ENABLED=true
WEB_FETCH_MAX_CHARS=800
WEB_FETCH_TIMEOUT=8
WEB_FETCH_MAX_BYTES=524288

# 机器人昵称（用于清洗 @ 前缀和展示）
BOT_NAME=大肥鱼

# 官方 API 根地址
QQ_API_BASE=https://api.sgroup.qq.com

# Access Token 接口；主接口失败时自动尝试 fallback
TOKEN_URL=https://bots.qq.com/app/getAppAccessToken
TOKEN_FALLBACK_URL=https://api.bot.qq.com/app/getAppAccessToken
TOKEN_REFRESH_MARGIN=300

# 事件订阅位：
# GROUP_AND_C2C_EVENT (1<<25) | PUBLIC_GUILD_MESSAGES (1<<30)
# = 1107296256。1<<25 同时覆盖群@、群全量消息和私聊 C2C。
# 群聊要接收非 @ 消息，还需在开放平台开启“接收所有消息”。
INTENTS=1107296256

# 每次传给处理器的上下文窗口，仅支持 5000 / 10000 / 50000 字。
# 群内也可用 /context 5000|1w|5w 单独调整并持久化。
CONTEXT_WINDOW=5000

# 本地上传图片大小上限（MB）。群聊直传官方建议不超过 5MB。
MAX_LOCAL_IMAGE_MB=5

# 超时与日志
HTTP_TIMEOUT=30
WS_HELLO_TIMEOUT=20
LOG_LEVEL=INFO
